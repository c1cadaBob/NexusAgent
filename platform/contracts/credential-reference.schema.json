{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/credential-reference.schema.json",
  "title": "NexusAgent CredentialReference",
  "description": "Reference-only credential contract. Secrets stay inside Credential Center or its provider backend and must not cross platform service boundaries as plaintext.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_ref",
    "tenant_id",
    "trace_id",
    "purpose",
    "lease_mode",
    "issued_at_utc",
    "expires_at_utc"
  ],
  "properties": {
    "credential_ref": { "type": "string", "pattern": "^cred_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "user_id": { "$ref": "common-identifiers.schema.json#/$defs/user_id" },
    "agent_id": { "$ref": "common-identifiers.schema.json#/$defs/agent_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "purpose": { "type": "string", "enum": ["channel_delivery", "planner_context", "executor_tool", "artifact_access", "admin_operation"] },
    "lease_mode": { "type": "string", "enum": ["reference_only", "short_lived_token"] },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "issued_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "expires_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logs", "events", "artifacts"],
      "properties": {
        "logs": { "const": "redacted" },
        "events": { "const": "redacted" },
        "artifacts": { "const": "secret_scan_required" }
      }
    }
  }
}

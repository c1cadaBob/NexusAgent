{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/native-host-binding.schema.json",
  "title": "NativeHostBinding",
  "description": "Internal binding from an approved platform capability to a native host sidecar and provider version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "native_host",
    "provider_version",
    "capability_id",
    "host_endpoint_ref",
    "health_status",
    "rollback_target"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1 },
    "native_host": {
      "type": "string",
      "enum": ["channel_gateway_sidecar", "planner_sidecar", "executor_sidecar"]
    },
    "provider_version": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "host_endpoint_ref": {
      "type": "string",
      "description": "Internal endpoint reference. Product APIs must not expose raw native host URLs."
    },
    "health_status": { "type": "string", "enum": ["unknown", "healthy", "degraded", "unhealthy"] },
    "rollback_target": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/task-state.schema.json",
  "title": "NexusAgent TaskState",
  "description": "Seven-layer platform task state snapshot. Fine-grained states are grouped into intake, admission, planning, approval, execution, settlement, and terminal layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "task_id",
    "attempt_id",
    "trace_id",
    "state",
    "state_layer",
    "previous_state",
    "outcome",
    "updated_at_utc",
    "monotonic_ms",
    "version"
  ],
  "properties": {
    "schema_version": { "const": "nexus.task_state.v1" },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "task_id": { "$ref": "common-identifiers.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" },
    "execution_id": { "$ref": "common-identifiers.schema.json#/$defs/execution_id" },
    "conversation_id": { "$ref": "common-identifiers.schema.json#/$defs/conversation_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "state": {
      "type": "string",
      "enum": [
        "received",
        "admitted",
        "blocked",
        "planning",
        "approval_required",
        "ready_for_execution",
        "executing",
        "settling",
        "completed",
        "failed",
        "cancelled",
        "archived"
      ]
    },
    "state_layer": {
      "type": "string",
      "enum": ["intake", "admission", "planning", "approval", "execution", "settlement", "terminal"]
    },
    "previous_state": {
      "type": ["string", "null"],
      "enum": [
        null,
        "received",
        "admitted",
        "blocked",
        "planning",
        "approval_required",
        "ready_for_execution",
        "executing",
        "settling",
        "completed",
        "failed",
        "cancelled",
        "archived"
      ]
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": [null, "succeeded", "failed", "cancelled", "blocked"]
    },
    "transition_reason": { "type": "string", "minLength": 1 },
    "updated_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "monotonic_ms": { "$ref": "common-identifiers.schema.json#/$defs/monotonic_ms" },
    "version": { "type": "integer", "minimum": 1 }
  }
}

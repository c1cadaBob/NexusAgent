{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/plugin-admission-policy.schema.json",
  "title": "PluginAdmissionPolicy",
  "description": "Policy-Gate governed admission policy for plugin inventory entries and tenant-visible capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "allowed_sources",
    "allowed_capability_types",
    "credential_policy",
    "network_policy",
    "sandbox_policy",
    "tenant_scope",
    "approval_state"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "allowed_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_capability_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["channel", "message_transform", "skill", "mcp_server", "tool", "planner_hint"]
      }
    },
    "credential_policy": {
      "type": "string",
      "enum": ["credential_ref_only", "no_credentials", "blocked"]
    },
    "network_policy": {
      "type": "string",
      "enum": ["deny_by_default", "approved_destinations_only", "host_sidecar_only"]
    },
    "sandbox_policy": {
      "type": "string",
      "enum": ["required", "host_managed", "not_applicable"]
    },
    "tenant_scope": {
      "type": "string",
      "enum": ["platform_admin_only", "approved_tenants", "all_tenants"]
    },
    "approval_state": {
      "type": "string",
      "enum": ["draft", "pending_review", "approved", "disabled", "rejected"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/platform-error.schema.json",
  "title": "NexusAgent PlatformError",
  "description": "Public platform error responses. Codes are platform-owned and do not expose internal implementation identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "trace_id"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "PLATFORM_INVALID_REQUEST",
        "PLATFORM_UNAUTHENTICATED",
        "PLATFORM_FORBIDDEN",
        "PLATFORM_NOT_FOUND",
        "PLATFORM_CONFLICT",
        "PLATFORM_RATE_LIMITED",
        "PLATFORM_POLICY_DENIED",
        "PLATFORM_APPROVAL_REQUIRED",
        "PLATFORM_TASK_NOT_CANCELABLE",
        "PLATFORM_INVALID_STATE_TRANSITION",
        "PLATFORM_CROSS_TENANT_ID",
        "PLATFORM_SCHEMA_VALIDATION_FAILED",
        "PLATFORM_PROVIDER_UNAVAILABLE",
        "PLATFORM_TIMEOUT",
        "PLATFORM_INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^trace_[A-Za-z0-9_-]+$"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

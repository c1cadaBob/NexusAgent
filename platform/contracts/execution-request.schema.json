{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/execution-request.schema.json",
  "title": "NexusAgent ExecutionRequest",
  "description": "Internal platform executor request. Provider adapters receive this schema only, then translate it inside the selected executor provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "task_id",
    "attempt_id",
    "execution_id",
    "trace_id",
    "requested_at_utc",
    "monotonic_ms",
    "tool",
    "policy",
    "sandbox_policy",
    "network_policy",
    "resource_budget",
    "artifact_policy",
    "credential_refs"
  ],
  "properties": {
    "schema_version": { "const": "nexus.execution_request.p2.v1" },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "user_id": { "$ref": "common-identifiers.schema.json#/$defs/user_id" },
    "agent_id": { "$ref": "common-identifiers.schema.json#/$defs/agent_id" },
    "task_id": { "$ref": "common-identifiers.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" },
    "execution_id": { "$ref": "common-identifiers.schema.json#/$defs/execution_id" },
    "conversation_id": { "$ref": "common-identifiers.schema.json#/$defs/conversation_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "requested_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "monotonic_ms": { "$ref": "common-identifiers.schema.json#/$defs/monotonic_ms" },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "input": { "type": "object", "additionalProperties": true }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow_native_agent_loop", "require_policy_gate", "require_artifact_store", "allowed_tools"],
      "properties": {
        "mode": { "const": "executor-only" },
        "allow_native_agent_loop": { "const": false },
        "require_policy_gate": { "const": true },
        "require_artifact_store": { "const": true },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sandbox_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "file_system"],
      "properties": {
        "mode": { "type": "string", "enum": ["required", "host_managed"] },
        "file_system": { "type": "string", "enum": ["deny_by_default", "workspace_readonly"] }
      }
    },
    "network_policy": {
      "type": "string",
      "enum": ["deny_by_default", "approved_destinations_only", "host_sidecar_only"]
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_stdout_bytes", "max_stderr_bytes", "max_artifact_bytes"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_stdout_bytes": { "type": "integer", "minimum": 0 },
        "max_stderr_bytes": { "type": "integer", "minimum": 0 },
        "max_artifact_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "store"],
      "properties": {
        "mode": { "const": "reference_only" },
        "store": { "const": "artifact_store" }
      }
    },
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_ref", "purpose"],
        "properties": {
          "credential_ref": { "type": "string", "pattern": "^cred_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
          "purpose": { "const": "executor_tool" }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/plugin-inventory.schema.json",
  "title": "PluginInventory",
  "description": "Internal Plugin Bridge inventory record. Product APIs may expose only platform-facing projections of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_id",
    "source_type",
    "source_ref",
    "version",
    "sha256",
    "native_host",
    "license",
    "risk_level",
    "allowlist_status",
    "trace_id"
  ],
  "properties": {
    "plugin_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["marketplace", "package_registry", "git_repository", "local_snapshot", "mcp_manifest"]
    },
    "source_ref": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "minLength": 1 },
    "native_host": {
      "type": "string",
      "enum": ["channel_gateway_sidecar", "planner_sidecar", "executor_sidecar"]
    },
    "license": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "allowlist_status": {
      "type": "string",
      "enum": ["pending_scan", "pending_review", "approved", "disabled", "rejected"]
    },
    "reviewer": { "type": "string" },
    "capability_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "trace_id": { "type": "string", "minLength": 1 }
  }
}

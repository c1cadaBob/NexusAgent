{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/artifact-reference.schema.json",
  "title": "NexusAgent ArtifactReference",
  "description": "Platform-owned artifact reference. Public and cross-service payloads carry references and integrity metadata, not native file paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "tenant_id",
    "task_id",
    "trace_id",
    "kind",
    "storage_ref",
    "content_type",
    "sha256",
    "created_at_utc"
  ],
  "properties": {
    "artifact_id": { "$ref": "common-identifiers.schema.json#/$defs/artifact_id" },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "task_id": { "$ref": "common-identifiers.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" },
    "execution_id": { "$ref": "common-identifiers.schema.json#/$defs/execution_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "kind": { "type": "string", "enum": ["input_attachment", "execution_output", "log_excerpt", "planner_snapshot", "audit_evidence"] },
    "storage_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque platform storage reference resolved only by Artifact Store. It must not contain local native host paths."
    },
    "content_type": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "classification": { "type": "string", "enum": ["public", "internal", "confidential", "secret"] },
    "created_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "expires_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" }
  }
}

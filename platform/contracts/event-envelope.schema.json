{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/event-envelope.schema.json",
  "title": "NexusAgent PlatformEventEnvelope",
  "description": "Provider-neutral event envelope used by Coordinator, Policy-Gate, Event Bus, adapters, audit, and observability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "trace_id",
    "occurred_at_utc",
    "monotonic_ms",
    "producer",
    "subject",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "nexus.event_envelope.v1" },
    "event_id": { "type": "string", "pattern": "^event_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "event_type": {
      "type": "string",
      "enum": [
        "task.received",
        "task.state_changed",
        "task.state_transition_rejected",
        "policy.denied",
        "approval.required",
        "planning.started",
        "planning.completed",
        "execution.started",
        "execution.blocked",
        "execution.cancelled",
        "execution.completed",
        "execution.failed",
        "sandbox.denied",
        "artifact.created",
        "credential.lease_issued",
        "audit.recorded"
      ]
    },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "user_id": { "$ref": "common-identifiers.schema.json#/$defs/user_id" },
    "agent_id": { "$ref": "common-identifiers.schema.json#/$defs/agent_id" },
    "task_id": { "$ref": "common-identifiers.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" },
    "execution_id": { "$ref": "common-identifiers.schema.json#/$defs/execution_id" },
    "conversation_id": { "$ref": "common-identifiers.schema.json#/$defs/conversation_id" },
    "artifact_id": { "$ref": "common-identifiers.schema.json#/$defs/artifact_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "occurred_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "monotonic_ms": { "$ref": "common-identifiers.schema.json#/$defs/monotonic_ms" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "component"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "provider_binding_id": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["task", "attempt", "execution", "artifact", "credential", "approval", "audit"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

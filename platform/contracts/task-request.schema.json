{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusagent.local/contracts/task-request.schema.json",
  "title": "NexusAgent TaskRequest",
  "description": "Platform-owned task intake contract. Channel, planner, and executor providers receive this normalized shape through adapters only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "user_id",
    "agent_id",
    "task_id",
    "attempt_id",
    "conversation_id",
    "trace_id",
    "source",
    "input",
    "policy_context",
    "created_at_utc",
    "monotonic_ms"
  ],
  "properties": {
    "schema_version": { "const": "nexus.task_request.v1" },
    "tenant_id": { "$ref": "common-identifiers.schema.json#/$defs/tenant_id" },
    "user_id": { "$ref": "common-identifiers.schema.json#/$defs/user_id" },
    "agent_id": { "$ref": "common-identifiers.schema.json#/$defs/agent_id" },
    "task_id": { "$ref": "common-identifiers.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" },
    "execution_id": { "$ref": "common-identifiers.schema.json#/$defs/execution_id" },
    "conversation_id": { "$ref": "common-identifiers.schema.json#/$defs/conversation_id" },
    "trace_id": { "$ref": "common-identifiers.schema.json#/$defs/trace_id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "channel", "received_at_utc"],
      "properties": {
        "kind": { "type": "string", "enum": ["api", "channel", "scheduler", "system"] },
        "channel": { "type": "string", "minLength": 1 },
        "provider_binding_id": { "type": "string", "minLength": 1 },
        "received_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
        "message_id": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
        "account_ref": { "type": "string", "pattern": "^channel_account_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
        "conversation_ref": { "type": "string", "pattern": "^channel_conversation_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "type": "string", "enum": ["text", "command", "approval_action"] },
        "text": { "type": "string", "minLength": 1 },
        "attachments": {
          "type": "array",
          "items": { "$ref": "artifact-reference.schema.json" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "idempotency_key", "source_message_id"],
      "properties": {
        "schema_version": { "const": "nexus.task_command.p4.v1" },
        "action": { "type": "string", "enum": ["continue_attempt", "redo_attempt", "cancel_attempt"] },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "source_message_id": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
        "next_attempt_id": { "$ref": "common-identifiers.schema.json#/$defs/attempt_id" }
      }
    },
    "policy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rbac_subject", "tenant_scope", "approval_mode"],
      "properties": {
        "rbac_subject": { "type": "string", "minLength": 1 },
        "tenant_scope": { "type": "string", "enum": ["single_tenant", "cross_tenant_denied"] },
        "approval_mode": { "type": "string", "enum": ["not_required", "required_before_execution"] },
        "budget_ref": { "type": "string", "minLength": 1 }
      }
    },
    "created_at_utc": { "$ref": "common-identifiers.schema.json#/$defs/utc_timestamp" },
    "monotonic_ms": { "$ref": "common-identifiers.schema.json#/$defs/monotonic_ms" },
    "idempotency_key": { "type": "string", "minLength": 1 }
  }
}

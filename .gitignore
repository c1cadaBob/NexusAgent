# Dependencies and local caches
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build and runtime output
dist/
build/
coverage/
.cache/
.turbo/
*.log

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.yaml
*.local.yml

# IDE and OS files
.idea/
.vscode/
.DS_Store

# Generated vendor snapshot metadata is tracked; transient copies are not.
vendor/**/node_modules/
vendor/**/.pnpm-store/
vendor/**/__pycache__/
vendor/**/dist/
vendor/**/build/

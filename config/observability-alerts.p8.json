{
  "schema_version": "nexus.observability_readiness.p8.v1",
  "task_id": "P8-03",
  "profile_id": "observability_readiness_p8_03_production_default",
  "rpo_minutes": 15,
  "rto_hours": 4,
  "backend_defaults": {
    "event_bus": "nats_jetstream",
    "artifact_store": "s3_compatible_object_store",
    "credential_center": "vault",
    "memory_store": "postgres_pgvector",
    "observability": "otel_prometheus_loki_tempo"
  },
  "slo_targets": {
    "api_availability_percent": 99.5,
    "task_success_percent": 99.0,
    "event_replay_lag_minutes": 15,
    "backup_freshness_minutes": 15,
    "restore_drill_rto_hours": 4
  },
  "alerts": [
    {
      "alert_id": "alert_api_availability_p8_03",
      "signal": "api.availability",
      "severity": "critical",
      "threshold": "below_99_5_percent_5m",
      "backend": "otel_prometheus_loki_tempo",
      "runbook": "docs/operations/observability-alerts.md#api-availability"
    },
    {
      "alert_id": "alert_task_failure_rate_p8_03",
      "signal": "task.failure_rate",
      "severity": "warning",
      "threshold": "above_1_percent_15m",
      "backend": "otel_prometheus_loki_tempo",
      "runbook": "docs/operations/observability-alerts.md#task-failure-rate"
    },
    {
      "alert_id": "alert_adapter_degradation_p8_03",
      "signal": "adapter.degradation",
      "severity": "critical",
      "threshold": "any_default_provider_degraded_5m",
      "backend": "otel_prometheus_loki_tempo",
      "runbook": "docs/operations/observability-alerts.md#adapter-degradation"
    },
    {
      "alert_id": "alert_event_backlog_dlq_p8_03",
      "signal": "event.backlog_dlq",
      "severity": "critical",
      "threshold": "replay_lag_over_15m_or_dlq_growth",
      "backend": "nats_jetstream",
      "runbook": "docs/operations/observability-alerts.md#event-backlog-and-dlq"
    },
    {
      "alert_id": "alert_artifact_checksum_p8_03",
      "signal": "artifact.checksum_failure",
      "severity": "critical",
      "threshold": "any_checksum_mismatch",
      "backend": "s3_compatible_object_store",
      "runbook": "docs/operations/backup-restore.md#artifact-checksum"
    },
    {
      "alert_id": "alert_credential_lease_p8_03",
      "signal": "credential.lease_failure",
      "severity": "critical",
      "threshold": "any_reference_or_lease_failure",
      "backend": "vault",
      "runbook": "docs/operations/backup-restore.md#credential-reference-only-restore"
    },
    {
      "alert_id": "alert_memory_conflict_sweep_p8_03",
      "signal": "memory.conflict_sweep_anomaly",
      "severity": "warning",
      "threshold": "open_conflict_growth_or_sweep_failure",
      "backend": "postgres_pgvector",
      "runbook": "docs/operations/backup-restore.md#memory-version-continuity"
    },
    {
      "alert_id": "alert_backup_freshness_p8_03",
      "signal": "backup.freshness",
      "severity": "critical",
      "threshold": "older_than_15m",
      "backend": "s3_compatible_object_store",
      "runbook": "docs/operations/backup-restore.md#backup-freshness"
    },
    {
      "alert_id": "alert_restore_drill_p8_03",
      "signal": "restore.drill_status",
      "severity": "critical",
      "threshold": "last_drill_failed_or_missing",
      "backend": "otel_prometheus_loki_tempo",
      "runbook": "docs/operations/incident-restore-drill.md#restore-drill-gate"
    }
  ],
  "label_policy": {
    "required": ["tenant_id", "trace_id", "service", "signal"],
    "allowed_extra": ["task_id", "attempt_id", "execution_id", "conversation_id", "artifact_id", "policy_id", "provider_id"],
    "forbidden_values": ["raw_credential", "credential_material", "native_url", "native_path", "native_session", "native_error", "provider_runtime", "absolute_local_path"]
  }
}
